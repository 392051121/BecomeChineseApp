{
  "expo": {
    "name": "Become Chinese",
    "slug": "BecomeChineseApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "becomechinese",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "description": "Discover the beauty of Chinese culture through daily solar terms, an interactive exploration map, authentic recipes, and a Chinese name generator. Learn, explore, and share — no account required, works fully offline.",
    "primaryColor": "#B33B24",
    "backgroundColor": "#FDFBF7",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FDFBF7"
    },
    "androidStatusBar": {
      "barStyle": "dark-content",
      "backgroundColor": "#00000000",
      "translucent": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.becomechinese.atlas",
      "buildNumber": "1",
      "infoPlist": {
        "CFBundleDisplayName": "Become Chinese",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FDFBF7"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.becomechinese.atlas",
      "versionCode": 1,
      "permissions": [
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-notifications",
        {
          "color": "#B33B24",
          "defaultChannel": "daily-solar-term"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "addac4c9-d8a5-448f-9f27-e275826740ed"
      }
    },
    "privacyPolicyUrl": "https://392051121.github.io/BecomeChineseApp/privacy.html",
    "supportUrl": "https://github.com/392051121/BecomeChineseApp"
  }
}
